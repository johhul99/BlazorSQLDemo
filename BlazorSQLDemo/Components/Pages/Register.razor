@page "/register"
@using BlazorSQLDemo.Models
@using BlazorSQLDemo.Data
@rendermode InteractiveServer
@inject EmployeeService EmployeeService


<h1>Register</h1>

<div class="container">
    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">First Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.FirstName" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Last Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.LastName" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Email</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.Email" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Position</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="employee.Position" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="d-flex justify-content-center">
            <button class="btn btn-primary px-4" @onclick="RegisterEmployee">Submit</button>
        </div>

        @if(!string.IsNullOrEmpty(successMessage)){
            <div class="text-center mt-3">
                <p class="text-success">@successMessage</p>
            </div>
        }
    </div>

    <div class="container">
        <div class="table-responsive">
            <table class="table table-bordered table-striped shadow">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Employees is not null && Employees.Any()){
                        @foreach (var employee in Employees){
                            <tr>
                                <td>@employee.Id</td>
                                <td>@employee.FirstName</td>
                                <td>@employee.LastName</td>
                                <td>@employee.Email</td>
                                <td>@employee.Position</td>
                            </tr>
                        }
                    }
                    else{
                        <tr>
                            <td colspan="5"class="text-center">No employees found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



@code {
    Employee employee = new Employee();
    private string successMessage = string.Empty;

    private List<Employee> Employees = new();

    private async Task RegisterEmployee(){

        await EmployeeService.AddEmployee(employee);

        employee = new Employee();

        successMessage = "Employee registered successfully!";
        StateHasChanged();

        await Task.Delay(3000);
        successMessage = string.Empty;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetEmployees();
    }

    
}
